{
  "name": "sousearch",
  "version": "0.2.0",
  "desktopName": "sousearch.desktop",
  "description": "Launcher de aplicativos para Linux (Zorin OS), estilo Ulauncher",
  "author": "Fooyer",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fooyer/SouSearch.git"
  },
  "main": "./out/main/index.js",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "node scripts/run-electron-vite.js dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "start": "node scripts/run-electron-vite.js preview",
    "dist": "electron-vite build && electron-builder --linux",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "fuzzysort": "^4.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
